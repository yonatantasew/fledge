{
  "name": "@yonatantasew/fledge",
  "private": true,
  "type": "module",
  "description": "Build, install and release Flutter apps from a local web UI: flavors × build types for Android and iOS, device installs, and release notes drafted with Claude.",
  "scripts": {
    "dev": "node --watch server/index.ts --dev",
    "start": "vite build && node server/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test server/*.test.ts"
  },
  "engines": {
    "node": ">=23.6"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
