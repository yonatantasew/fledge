{
  "name": "@yonatantasew/fledge",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "description": "Build, install and release Flutter apps from a local web UI: flavors × build types for Android and iOS, device installs, and release notes drafted with Claude.",
  "bin": {
    "fledge": "bin/fledge.js"
  },
  "files": [
    "bin",
    "dist",
    "dist-server",
    "fledge.example.json",
    "README.md"
  ],
  "scripts": {
    "dev": "node --watch server/index.ts --dev",
    "start": "vite build && node server/index.ts",
    "build": "vite build && vite build --ssr server/index.ts --outDir dist-server --emptyOutDir",
    "typecheck": "tsc --noEmit",
    "test": "node --test server/*.test.ts server/ai/*.test.ts src/*.test.ts",
    "release": "node scripts/release.mjs"
  },
  "engines": {
    "node": ">=20.11"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
